rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // TASKS
    // ==========================================

    match /tasks/{taskId} {

      function isOwner() {
        return request.auth != null
          && resource.data.userId == request.auth.uid;
      }

      function isValidTask() {
        return request.resource.data.title is string
          && request.resource.data.description is string
          && request.resource.data.completed is bool
          && request.resource.data.userId is string
          && request.resource.data.userId == request.auth.uid;
      }

      // Valida que completedAt cambie correctamente
      // según la transición del estado de la tarea.
      function hasValidCompletionTimestamp() {

        return (

          // Una tarea ya completada mantiene su fecha.
          request.resource.data.completed == true
          && resource.data.completed == true
          && request.resource.data.get('completedAt', null)
            == resource.data.get('completedAt', null)

        ) || (

          // Al completar una tarea, la fecha debe ser request.time.
          request.resource.data.completed == true
          && resource.data.completed == false
          && request.resource.data.completedAt == request.time

        ) || (

          // Al desmarcar una tarea, completedAt debe ser null.
          request.resource.data.completed == false
          && resource.data.completed == true
          && request.resource.data.get('completedAt', null) == null

        ) || (

          // Si continúa pendiente, la fecha no puede modificarse.
          request.resource.data.completed == false
          && resource.data.completed == false
          && request.resource.data.get('completedAt', null)
            == resource.data.get('completedAt', null)

        );
      }

      function hasExistingReward() {
        return exists(
          /databases/$(database)/documents/users/$(request.auth.uid)/gardenRewards/$(taskId)
        );
      }

      function hasNewValidReward() {
        return existsAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)/gardenRewards/$(taskId)
        )
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)/gardenRewards/$(taskId)
        ).data.taskId == taskId
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)/gardenRewards/$(taskId)
        ).data.points == 10
        && existsAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)/garden/progress
        )
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)/garden/progress
        ).data.lastRewardTaskId == taskId;
      }

      allow read: if isOwner();

      allow create: if request.auth != null
        && isValidTask();

      allow update: if isOwner()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'title',
            'description',
            'completed',
            'completedAt'
          ])
        && isValidTask()
        && hasValidCompletionTimestamp()
        && (
          request.resource.data.completed == resource.data.completed
          || request.resource.data.completed == false
          || (
            resource.data.completed == false
            && request.resource.data.completed == true
            && (
              hasExistingReward()
              || hasNewValidReward()
            )
          )
        );

      allow delete: if isOwner();
    }


    // ==========================================
    // GARDEN PROGRESS
    // ==========================================

    match /users/{userId}/garden/progress {

      function isGardenOwner() {
        return request.auth != null
          && request.auth.uid == userId;
      }

      function hasValidRewardAfter() {
        let taskId = request.resource.data.lastRewardTaskId;

        return !exists(
          /databases/$(database)/documents/users/$(userId)/gardenRewards/$(taskId)
        )
        && existsAfter(
          /databases/$(database)/documents/users/$(userId)/gardenRewards/$(taskId)
        )
        && existsAfter(
          /databases/$(database)/documents/tasks/$(taskId)
        )
        && getAfter(
          /databases/$(database)/documents/tasks/$(taskId)
        ).data.completed == true;
      }

      allow read: if isGardenOwner();

      allow create: if isGardenOwner()
        && request.resource.data.keys().hasOnly([
          'growthPoints',
          'totalWaterings',
          'lastRewardTaskId',
          'updatedAt'
        ])
        && request.resource.data.growthPoints == 10
        && request.resource.data.totalWaterings == 1
        && request.resource.data.lastRewardTaskId is string
        && request.resource.data.updatedAt == request.time
        && hasValidRewardAfter();

      allow update: if isGardenOwner()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'growthPoints',
            'totalWaterings',
            'lastRewardTaskId',
            'updatedAt'
          ])
        && request.resource.data.growthPoints
          == resource.data.growthPoints + 10
        && request.resource.data.totalWaterings
          == resource.data.totalWaterings + 1
        && request.resource.data.lastRewardTaskId is string
        && request.resource.data.updatedAt == request.time
        && hasValidRewardAfter();

      allow delete: if false;
    }


    // ==========================================
    // GARDEN REWARDS
    // ==========================================

    match /users/{userId}/gardenRewards/{taskId} {

      function isRewardOwner() {
        return request.auth != null
          && request.auth.uid == userId;
      }

      function isValidReward() {
        let taskPath = /databases/$(database)/documents/tasks/$(taskId);
        let progressPath = /databases/$(database)/documents/users/$(userId)/garden/progress;

        return exists(taskPath)
          && get(taskPath).data.userId == userId
          && get(taskPath).data.completed == false
          && existsAfter(taskPath)
          && getAfter(taskPath).data.completed == true
          && existsAfter(progressPath)
          && getAfter(progressPath).data.lastRewardTaskId == taskId;
      }

      allow read: if isRewardOwner();

      allow create: if isRewardOwner()
        && request.resource.data.keys().hasOnly([
          'taskId',
          'points',
          'createdAt'
        ])
        && request.resource.data.taskId == taskId
        && request.resource.data.points == 10
        && request.resource.data.createdAt == request.time
        && isValidReward();

      allow update, delete: if false;
    }
  }
}